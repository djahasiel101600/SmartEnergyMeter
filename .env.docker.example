# Copy this file to .env and fill in the values before running docker compose up

# ── Django ─────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (your domain or IP)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=smart_energy
POSTGRES_USER=smart_energy_user
POSTGRES_PASSWORD=change-me-strong-password

# ── CORS / CSRF ─────────────────────────────────────────────────────────────
# Set to your frontend's public URL (e.g. https://yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# ── Frontend public host (used to build the WebSocket URL) ──────────────────
# Set to your domain or IP (no scheme, no trailing slash)
PUBLIC_HOST=localhost

# ── Timezone ────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Manila

# ── Port (host port Nginx listens on) ───────────────────────────────────────
PORT=80
